# Cloudflare R2 Storage Configuration Example
VITE_R2_BUCKET_URL=https://bfda3f43ac31b00be80bcb82772eb8fa.r2.cloudflarestorage.com/mads-topup
VITE_R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
VITE_R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
VITE_R2_ENDPOINT=https://bfda3f43ac31b00be80bcb82772eb8fa.r2.cloudflarestorage.com
VITE_R2_BUCKET_NAME=mads-topup

# Firebase Google Authentication Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# Use the site's own domain (e.g. madstopup.com) so Google login works on Safari / in-app browsers.
# server.js proxies /__/auth/* to FIREBASE_AUTH_PROXY_HOST. Add https://<domain>/__/auth/handler
# to the OAuth client's Authorized redirect URIs in Google Cloud Console first.
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_AUTH_PROXY_HOST=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID


# Server-only secrets (VPS .env, never VITE_*)
# Firebase console > Project settings > Service accounts > Database secrets.
# Lets the server write wallet balances once database.rules.json is published.
FIREBASE_DB_SECRET=
# Shared key the EZ Cash SMS forwarder must send (?key=... or x-webhook-key header)
EZCASH_WEBHOOK_SECRET=
# Binance read-only API key for automatic Binance Pay deposits
# (Binance > API Management > Create API, tick only "Enable Reading", restrict to the VPS IP)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Admin login (all three required; admin login is blocked until they are set)
ADMIN_EMAIL=
# At least 12 characters. Use a new password you have never used anywhere else.
ADMIN_PASSWORD=
# New base32 secret for Google Authenticator. The old one is public and is refused.
ADMIN_TOTP_SECRET=

# Email (OTP + reseller approval mails). At least one of Zoho or Resend is needed.
# Test on the VPS with: node scripts/test-email.mjs you@gmail.com
# Zoho: use an app password (Zoho Mail > Settings > Security > App passwords).
ZOHO_EMAIL=info@trivexit.com
ZOHO_PASSWORD=
# Resend: the From address must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MADS TOPUP <no-reply@madstopup.com>

# Player name lookup (RapidAPI id-game-checker)
VITE_RAPIDAPI_KEY=
# Optional: Valorant endpoint path if RapidAPI changes it ({name} and {tag} are filled in)
# RAPIDAPI_VALORANT_PATH=valorant/{name}/{tag}
