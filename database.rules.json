{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()",
        "walletBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "walletUsdt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        }
      }
    },
    "orders": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "manual_payments": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "reseller_applications": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "siteConfig": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    },
    "settings": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    },
    "genieTransactions": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    },
    "genieLocalIdIndex": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    },
    "moogoldProcessedOrders": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    },
    "supportTickets": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "reviews": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "vouchers_log": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    }
  }
}
