{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren() && (!data.child('walletBalance').exists() || newData.child('walletBalance').exists()) && (!data.child('walletUsdt').exists() || newData.child('walletUsdt').exists()) && (!data.child('isReseller').exists() || newData.child('isReseller').exists()) && (!data.child('resellerStatus').exists() || newData.child('resellerStatus').exists()) && (!data.child('role').exists() || newData.child('role').exists()) && (!data.child('status').exists() || newData.child('status').exists())",
        "walletBalance": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || newData.val() == data.val())"
        },
        "walletUsdt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || newData.val() == data.val())"
        },
        "isReseller": {
          ".validate": "newData.isBoolean() && (newData.val() == data.val() || newData.val() == false)"
        },
        "resellerStatus": {
          ".validate": "newData.val() == data.val() || (newData.isString() && newData.val() != 'APPROVED')"
        },
        "role": {
          ".validate": "newData.val() == data.val() || (newData.isString() && newData.val() != 'reseller' && newData.val() != 'Reseller Partner' && newData.val() != 'admin')"
        },
        "status": {
          ".validate": "newData.val() == data.val() || (!data.exists() && newData.val() == 'ACTIVE')"
        }
      }
    },
    "orders": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "manual_payments": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "reseller_applications": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "siteConfig": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()"
      }
    },
    "settings": {
      ".read": true,
      "$id": {
        ".write": "$id != 'vouchers' && newData.exists()"
      }
    },
    "genieTransactions": {
      ".read": true,
      ".write": false
    },
    "genieLocalIdIndex": {
      ".read": true,
      ".write": false
    },
    "moogoldProcessedOrders": {
      ".read": true,
      ".write": false
    },
    "supportTickets": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "reviews": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "vouchers_log": {
      ".read": true,
      ".write": false
    }
  }
}
