{
  "rules": {
    "users": {
      "$uid": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren() && (!data.child('walletBalance').exists() || newData.child('walletBalance').exists()) && (!data.child('walletUsdt').exists() || newData.child('walletUsdt').exists()) && (!data.child('isReseller').exists() || newData.child('isReseller').exists()) && (!data.child('resellerStatus').exists() || newData.child('resellerStatus').exists()) && (!data.child('role').exists() || newData.child('role').exists()) && (!data.child('status').exists() || newData.child('status').exists()) && (!data.child('password').exists() || newData.child('password').exists()) && (!data.child('email').exists() || newData.child('email').val() == data.child('email').val()) && (!data.child('uid').exists() || newData.child('uid').val() == data.child('uid').val()) && (!data.child('sessionsValidAfter').exists() || newData.child('sessionsValidAfter').val() == data.child('sessionsValidAfter').val())",
        "walletBalance": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || newData.val() == data.val())"
        },
        "walletUsdt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || newData.val() == data.val())"
        },
        "isReseller": {
          ".validate": "newData.isBoolean() && (newData.val() == data.val() || newData.val() == false)"
        },
        "resellerStatus": {
          ".validate": "newData.val() == data.val() || (newData.isString() && newData.val() != 'APPROVED')"
        },
        "role": {
          ".validate": "newData.val() == data.val() || (newData.isString() && newData.val() != 'reseller' && newData.val() != 'Reseller Partner' && newData.val() != 'admin')"
        },
        "status": {
          ".validate": "newData.val() == data.val() || (!data.exists() && newData.val() == 'ACTIVE')"
        },
        "password": {
          ".validate": "newData.isString() && ((!data.exists() && !data.parent().exists()) || newData.val() == data.val())"
        },
        "email": {
          ".validate": "newData.isString() && ((!data.exists() && !data.parent().exists()) || newData.val() == data.val())"
        },
        "uid": {
          ".validate": "newData.isString() && ((!data.exists() && !data.parent().exists()) || newData.val() == data.val())"
        },
        "sessionsValidAfter": {
          ".validate": "newData.val() == data.val()"
        },
        "resellerSalesLkr": {
          ".validate": "newData.val() == data.val()"
        },
        "resellerTier": {
          ".validate": "newData.val() == data.val()"
        },
        "resellerJoinedAt": {
          ".validate": "newData.val() == data.val()"
        },
        "resellerJoinDepositLkr": {
          ".validate": "newData.val() == data.val()"
        }
      }
    },
    "orders": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren() && (newData.child('status').val() != 'COMPLETED' || (newData.child('partnerOrderId').isString() && (root.child('moogoldProcessedOrders').child(newData.child('partnerOrderId').val()).child('status').val() == 'COMPLETED' || root.child('moogoldProcessedOrders').child(newData.child('partnerOrderId').val()).child('status').val() == 'PROCESSING')))"
      }
    },
    "manual_payments": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren() && !newData.child('credited').exists() && !newData.child('creditedTo').exists()"
      }
    },
    "reseller_applications": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren()",
        "status": {
          ".validate": "newData.val() == data.val() || newData.val() != 'APPROVED'"
        }
      }
    },
    "siteConfig": {
      ".read": true,
      ".write": false
    },
    "settings": {
      ".read": false,
      ".write": false,
      "customPrices": {
        ".read": true
      }
    },
    "genieTransactions": {
      ".read": false,
      ".write": false
    },
    "genieLocalIdIndex": {
      ".read": false,
      ".write": false
    },
    "moogoldProcessedOrders": {
      ".read": false,
      ".write": false
    },
    "supportTickets": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren()",
        "messages": {
          "$m": {
            "sender": {
              ".validate": "newData.val() != 'admin'"
            }
          }
        }
      }
    },
    "reviews": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "vouchers_log": {
      ".read": false,
      ".write": false
    },
    "usedPaymentRefs": {
      ".read": false,
      ".write": false
    },
    "userVouchers": {
      ".read": false,
      ".write": false
    },
    "userSecrets": {
      ".read": false,
      ".write": false
    }
  }
}
